{
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(tsc:*)",
      "Bash(java:*)",
      "Bash(bash -c*)",
      "Bash(ls:*)",
      "Bash(aws:*)",
      "Bash(terraform:*)",
      "Bash(xargs grep:*)",
      "mcp__plugin_playwright_playwright__*",
      "mcp__robotmcp__*",
      "mcp__plugin_context7_context7__resolve-library-id",
      "mcp__plugin_context7_context7__query-docs",
      "mcp__vitest__run_tests",
      "mcp__vitest__list_tests",
      "mcp__vitest__set_project_root",
      "mcp__vitest__analyze_coverage"
    ],
    "defaultMode": "acceptEdits"
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "playwright",
    "robotmcp",
    "vitest"
  ],
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cmd /c \"cd frontend && npm run lint:fix 2>nul & npx tsc --noEmit --pretty false & cd ../backend && mvn compile -q\"",
            "timeout": 150,
            "statusMessage": "Checking compilation..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  }
}
